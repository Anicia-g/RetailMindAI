# ============================================================
# RetailMind AI — Backend Environment Configuration Example
# ============================================================

# Server Runtime Configuration
NODE_ENV=development
PORT=5001
FRONTEND_URL=http://localhost:3000

# Relational Database Configuration (MySQL / Cloud RDS / Aiven / TiDB)
# Set MYSQL_SSL=true when connecting to cloud-hosted MySQL instances (e.g. Aiven, AWS RDS, PlanetScale)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=retailmind_ai
MYSQL_SSL=false

# Authentication & Security
# Note: For production deployments, generate a strong 256-bit cryptographically random secret string.
JWT_SECRET=retailmind_jwt_super_secret_key_2026_production_grade
JWT_EXPIRES_IN=7d

# Machine Learning Microservice URL (FastAPI)
# Local: http://127.0.0.1:8000
# Production Render: https://retailmindai.onrender.com
ML_SERVICE_URL=https://retailmindai.onrender.com
ML_TIMEOUT_MS=15000

# OTP & Notifications
OTP_EXPIRY_MINUTES=10
OTP_DEV_AUTO_VERIFY=true

# PayPal Sandbox Configuration
# Get these credentials from https://developer.paypal.com > Apps & Credentials > Sandbox
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CURRENCY=USD
# Exchange rate for converting local INR amounts to PayPal USD (e.g. 85 INR = 1 USD)
PAYPAL_EXCHANGE_RATE_INR_TO_USD=85

# WhatsApp Business API Gateway (Optional / Configurable)
WHATSAPP_API_ENABLED=false
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
