# ============================================================
# RetailMind AI — Frontend (Next.js) Environment Configuration
# ============================================================

# Backend API Endpoint
# Local Development:
NEXT_PUBLIC_API_URL=http://localhost:5001/api

# PayPal Sandbox Configuration
# Provide the Sandbox Client ID obtained from https://developer.paypal.com > Apps & Credentials
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
NEXT_PUBLIC_PAYPAL_CURRENCY=USD
NEXT_PUBLIC_PAYPAL_EXCHANGE_RATE=85

# Production Deployment (e.g. Vercel):
# Set this in Vercel Project Settings > Environment Variables:
# NEXT_PUBLIC_API_URL=https://<your-deployed-backend-name>.onrender.com/api
